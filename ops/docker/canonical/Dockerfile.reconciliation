# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /workspace
ENV COREPACK_HOME=/tmp/corepack
RUN corepack enable && corepack prepare pnpm@10.15.1 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build:reconciliation && pnpm prune --prod

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000 LIRA_SANDBOX_ONLY=true LIRA_REAL_MONEY_ENABLED=false
COPY --from=build --chown=node:node /workspace/node_modules ./node_modules
COPY --from=build --chown=node:node /workspace/dist/services/reconciliation ./dist/services/reconciliation
COPY --from=build --chown=node:node /workspace/package.json ./package.json
USER node
EXPOSE 3000
CMD ["node","dist/services/reconciliation/index.js"]
