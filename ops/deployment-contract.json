{
  "version": 4,
  "principles": {
    "sandboxOnly": true,
    "realMoneyEnabled": false,
    "independentDeployUnits": true
  },
  "services": {
    "lira-web": {
      "dockerfile": "Dockerfile.web",
      "artifactSource": "canonical-repository",
      "watchPatterns": [
        "client/**",
        "shared/**",
        "apps/web/**",
        "Dockerfile.web",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "patches/**",
        "tsconfig.json",
        "vite.config.ts",
        "components.json"
      ]
    },
    "lira-api": {
      "dockerfile": "ops/docker/canonical/Dockerfile.api",
      "artifactSource": "canonical-repository",
      "watchPatterns": [
        "ops/docker/canonical/Dockerfile.api",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "patches/**",
        "tsconfig.json",
        "services/api/**",
        "server/**",
        "shared/**",
        "drizzle/**",
        "db/**",
        "scripts/**"
      ]
    },
    "lira-worker": {
      "dockerfile": "ops/docker/canonical/Dockerfile.worker",
      "artifactSource": "canonical-repository",
      "watchPatterns": [
        "ops/docker/canonical/Dockerfile.worker",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "patches/**",
        "tsconfig.json",
        "services/worker/**",
        "server/**",
        "shared/**",
        "drizzle/**"
      ]
    },
    "lira-reconciliation": {
      "dockerfile": "ops/docker/canonical/Dockerfile.reconciliation",
      "artifactSource": "canonical-repository",
      "watchPatterns": [
        "ops/docker/canonical/Dockerfile.reconciliation",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "patches/**",
        "tsconfig.json",
        "services/reconciliation/**",
        "server/**",
        "shared/**",
        "drizzle/**"
      ]
    }
  },
  "cutoverState": {
    "mode": "progressive-canonical",
    "canonicalServices": [
      "lira-api",
      "lira-worker",
      "lira-reconciliation"
    ],
    "archiveServices": [],
    "status": "api-worker-verified-reconciliation-prepared",
    "pendingService": "lira-reconciliation",
    "blocker": null,
    "note": "lira-api and lira-worker canonical deployments are verified SUCCESS. Repository contract now prepares lira-reconciliation for the final independent cutover."
  }
}
