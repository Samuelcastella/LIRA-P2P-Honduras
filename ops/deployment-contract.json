{
  "version": 1,
  "principles": {
    "sandboxOnly": true,
    "realMoneyEnabled": false,
    "independentDeployUnits": true
  },
  "services": {
    "lira-web": {
      "dockerfile": "Dockerfile.web",
      "artifactSource": "canonical-repository",
      "watchPatterns": [
        "client/**",
        "shared/**",
        "apps/web/**",
        "Dockerfile.web",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "patches/**",
        "vite.config.ts",
        "components.json"
      ]
    },
    "lira-api": {
      "dockerfile": "Dockerfile.api",
      "artifactSource": "lira-p2p-honduras-hardened-v2.zip",
      "watchPatterns": ["Dockerfile.api", "lira-p2p-honduras-hardened-v2.zip"]
    },
    "lira-worker": {
      "dockerfile": "Dockerfile.worker",
      "artifactSource": "lira-p2p-honduras-hardened-v2.zip",
      "watchPatterns": ["Dockerfile.worker", "lira-p2p-honduras-hardened-v2.zip"]
    },
    "lira-reconciliation": {
      "dockerfile": "Dockerfile.reconciliation",
      "artifactSource": "lira-p2p-honduras-hardened-v2.zip",
      "watchPatterns": ["Dockerfile.reconciliation", "lira-p2p-honduras-hardened-v2.zip"]
    }
  }
}
