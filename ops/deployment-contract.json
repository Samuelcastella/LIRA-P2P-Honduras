{
  "version": 2,
  "principles": {
    "sandboxOnly": true,
    "realMoneyEnabled": false,
    "independentDeployUnits": true
  },
  "services": {
    "lira-web": {
      "dockerfile": "Dockerfile.web",
      "artifactSource": "canonical-repository",
      "watchPatterns": [
        "client/**",
        "shared/**",
        "apps/web/**",
        "Dockerfile.web",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "patches/**",
        "tsconfig.json",
        "vite.config.ts",
        "components.json"
      ]
    },
    "lira-api": {
      "dockerfile": "ops/docker/canonical/Dockerfile.api",
      "artifactSource": "canonical-repository",
      "watchPatterns": [
        "ops/docker/canonical/Dockerfile.api",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "patches/**",
        "tsconfig.json",
        "services/api/**",
        "server/**",
        "shared/**",
        "drizzle/**",
        "db/**",
        "scripts/**"
      ]
    },
    "lira-worker": {
      "dockerfile": "Dockerfile.worker",
      "artifactSource": "lira-p2p-honduras-hardened-v2.zip",
      "watchPatterns": [
        "Dockerfile.worker",
        ".dockerignore",
        "lira-p2p-honduras-hardened-v2.zip"
      ]
    },
    "lira-reconciliation": {
      "dockerfile": "Dockerfile.reconciliation",
      "artifactSource": "lira-p2p-honduras-hardened-v2.zip",
      "watchPatterns": [
        "Dockerfile.reconciliation",
        ".dockerignore",
        "lira-p2p-honduras-hardened-v2.zip"
      ]
    }
  },
  "cutoverState": {
    "mode": "progressive-canonical",
    "canonicalServices": [
      "lira-api"
    ],
    "archiveServices": [
      "lira-worker",
      "lira-reconciliation"
    ],
    "note": "Repository contract prepared for API-first cutover. Worker and reconciliation remain archive-backed until their independent verification steps complete."
  }
}
