{
  "version": 1,
  "principles": {
    "sandboxOnly": true,
    "realMoneyEnabled": false,
    "independentDeployUnits": true
  },
  "services": {
    "lira-web": {
      "dockerfile": "Dockerfile.web",
      "artifactSource": "canonical-repository",
      "watchPatterns": [
        "client/**",
        "shared/**",
        "apps/web/**",
        "Dockerfile.web",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "patches/**",
        "tsconfig.json",
        "vite.config.ts",
        "components.json"
      ]
    },
    "lira-api": {
      "dockerfile": "Dockerfile.api",
      "artifactSource": "lira-p2p-honduras-hardened-v2.zip",
      "watchPatterns": [
        "Dockerfile.api",
        ".dockerignore",
        "lira-p2p-honduras-hardened-v2.zip"
      ],
      "canonicalCandidateDockerfile": "Dockerfile.api.canonical",
      "canonicalWatchPatterns": [
        "Dockerfile.api.canonical",
        "services/api/**",
        "db/**",
        "scripts/**",
        "server/**",
        "shared/**",
        "drizzle/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "patches/**",
        "tsconfig.json",
        "drizzle.config.ts"
      ]
    },
    "lira-worker": {
      "dockerfile": "Dockerfile.worker",
      "artifactSource": "lira-p2p-honduras-hardened-v2.zip",
      "watchPatterns": [
        "Dockerfile.worker",
        ".dockerignore",
        "lira-p2p-honduras-hardened-v2.zip"
      ],
      "canonicalCandidateDockerfile": "Dockerfile.worker.canonical",
      "canonicalWatchPatterns": [
        "Dockerfile.worker.canonical",
        "services/worker/**",
        "server/**",
        "shared/**",
        "drizzle/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "patches/**",
        "tsconfig.json",
        "drizzle.config.ts"
      ]
    },
    "lira-reconciliation": {
      "dockerfile": "Dockerfile.reconciliation",
      "artifactSource": "lira-p2p-honduras-hardened-v2.zip",
      "watchPatterns": [
        "Dockerfile.reconciliation",
        ".dockerignore",
        "lira-p2p-honduras-hardened-v2.zip"
      ],
      "canonicalCandidateDockerfile": "Dockerfile.reconciliation.canonical",
      "canonicalWatchPatterns": [
        "Dockerfile.reconciliation.canonical",
        "services/reconciliation/**",
        "server/**",
        "shared/**",
        "drizzle/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "patches/**",
        "tsconfig.json",
        "drizzle.config.ts"
      ]
    }
  }
}
