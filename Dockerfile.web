# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /workspace
ENV COREPACK_HOME=/tmp/corepack
RUN apt-get update && apt-get install -y --no-install-recommends unzip ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable && corepack prepare pnpm@10.4.1 --activate
COPY lira-p2p-honduras-hardened-v2.zip /tmp/lira.zip
RUN unzip -q /tmp/lira.zip -d /workspace
# Transitional sandbox gate: regenerate/freeze the lockfile before any real-money release.
RUN pnpm install --no-frozen-lockfile
RUN pnpm build:web
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=build --chown=node:node /workspace/dist/public ./dist/public
COPY --from=build --chown=node:node /workspace/apps/web ./apps/web
USER node
EXPOSE 3000
CMD ["node","apps/web/index.mjs"]
